{
  "topic": "social", "order": 12, "title": "Conversación social",
  "description": "Saludos, cortesía y muletillas para que la conversación fluya.",
  "entries": [
    { "pt": "Olá!", "es": "¡Hola!", "pos": "interjección", "exPt": "Olá, tudo bem?", "exEs": "Hola, ¿qué tal?" },
    { "pt": "Bom dia", "es": "Buenos días", "pos": "expresión", "exPt": "Bom dia! Dormiu bem?", "exEs": "¡Buenos días! ¿Ha dormido bien?" },
    { "pt": "Boa tarde", "es": "Buenas tardes", "pos": "expresión", "exPt": "Boa tarde, queria um café.", "exEs": "Buenas tardes, querría un café.", "note": "Se usa desde el mediodía hasta que anochece." },
    { "pt": "Boa noite", "es": "Buenas noches", "pos": "expresión", "exPt": "Boa noite e até amanhã.", "exEs": "Buenas noches y hasta mañana.", "note": "Sirve para saludar y para despedirse por la noche." },
    { "pt": "Tudo bem?", "es": "¿Qué tal? ¿Todo bien?", "pos": "expresión", "exPt": "— Tudo bem? — Tudo, e contigo?", "exEs": "— ¿Qué tal? — Bien, ¿y tú?" },
    { "pt": "obrigado / obrigada", "es": "gracias", "pos": "expresión", "exPt": "Muito obrigado pela ajuda.", "exEs": "Muchas gracias por la ayuda.", "note": "Concuerda con quien habla: un hombre dice «obrigado», una mujer «obrigada»." },
    { "pt": "De nada", "es": "De nada", "pos": "expresión", "exPt": "— Obrigado! — De nada.", "exEs": "— ¡Gracias! — De nada." },
    { "pt": "se faz favor", "es": "por favor", "pos": "expresión", "exPt": "A conta, se faz favor.", "exEs": "La cuenta, por favor.", "note": "También sirve para llamar la atención del camarero: «Se faz favor!»." },
    { "pt": "Desculpe", "es": "Perdone, disculpe", "pos": "expresión", "exPt": "Desculpe, onde fica o metro?", "exEs": "Perdone, ¿dónde está el metro?", "register": "formal" },
    { "pt": "Desculpa", "es": "Perdona", "pos": "expresión", "exPt": "Desculpa o atraso!", "exEs": "¡Perdona el retraso!", "register": "informal" },
    { "pt": "Com licença", "es": "Con permiso", "pos": "expresión", "exPt": "Com licença, posso passar?", "exEs": "Con permiso, ¿puedo pasar?" },
    { "pt": "Não faz mal", "es": "No pasa nada", "pos": "expresión", "exPt": "— Desculpa! — Não faz mal.", "exEs": "— ¡Perdona! — No pasa nada." },
    { "pt": "Muito prazer", "es": "Encantado / Mucho gusto", "pos": "expresión", "exPt": "Muito prazer, eu sou o Javier.", "exEs": "Encantado, yo soy Javier." },
    { "pt": "Até logo", "es": "Hasta luego", "pos": "expresión", "exPt": "Até logo, bom trabalho!", "exEs": "¡Hasta luego, que vaya bien el trabajo!" },
    { "pt": "Até amanhã", "es": "Hasta mañana", "pos": "expresión", "exPt": "Até amanhã, durmam bem.", "exEs": "Hasta mañana, que durmáis bien." },
    { "pt": "Adeus", "es": "Adiós", "pos": "expresión", "exPt": "Adeus, boa viagem!", "exEs": "¡Adiós, buen viaje!", "note": "Algo más definitivo que «até logo»." },
    { "pt": "Então?", "es": "¿Y bien? ¿Qué tal?; entonces", "pos": "expresión", "exPt": "Então, como correu?", "exEs": "Bueno, ¿qué tal fue?", "note": "Muletilla constante para empezar o retomar una conversación." },
    { "pt": "pois", "es": "pues, ya, claro", "pos": "interjección", "exPt": "— Está calor hoje. — Pois está!", "exEs": "— Hoy hace calor. — ¡Ya te digo!" },
    { "pt": "Pois é", "es": "Así es, ya ves", "pos": "expresión", "exPt": "— O tempo passa depressa. — Pois é.", "exEs": "— El tiempo pasa rápido. — Así es." },
    { "pt": "Está bem", "es": "Vale, de acuerdo", "pos": "expresión", "exPt": "— Vamos às oito? — Está bem.", "exEs": "— ¿Vamos a las ocho? — Vale." },
    { "pt": "Combinado", "es": "De acuerdo, quedamos así", "pos": "expresión", "exPt": "Às oito no café. Combinado?", "exEs": "A las ocho en el café. ¿De acuerdo?" },
    { "pt": "Olhe / Olha", "es": "Oiga / Oye; mire / mira", "pos": "interjección", "exPt": "Olha, amanhã não posso.", "exEs": "Oye, mañana no puedo.", "note": "«Olhe» con «o senhor / a senhora»; «olha» con «tu»." },
    { "pt": "Parabéns!", "es": "¡Felicidades! ¡Enhorabuena!", "pos": "expresión", "exPt": "Fazes anos hoje? Parabéns!", "exEs": "¿Hoy es tu cumpleaños? ¡Felicidades!" },
    { "pt": "Bem-vindo", "es": "Bienvenido", "pos": "expresión", "exPt": "Bem-vindo a Portugal!", "exEs": "¡Bienvenido a Portugal!" },
    { "pt": "Com certeza", "es": "Por supuesto", "pos": "expresión", "exPt": "— Pode ajudar-me? — Com certeza.", "exEs": "— ¿Me puede ayudar? — Por supuesto." },
    { "pt": "já agora", "es": "por cierto; ya que estamos", "pos": "expresión", "exPt": "Já agora, sabes onde é a farmácia?", "exEs": "Por cierto, ¿sabes dónde está la farmacia?", "difficulty": 2 },
    { "pt": "ou seja", "es": "o sea", "pos": "expresión", "exPt": "Chego às dez, ou seja, tarde.", "exEs": "Llego a las diez, o sea, tarde." },
    { "pt": "Percebeste?", "es": "¿Lo has entendido?", "pos": "expresión", "exPt": "Percebeste o que ele disse?", "exEs": "¿Has entendido lo que ha dicho?" },
    { "pt": "Pode falar mais devagar?", "es": "¿Puede hablar más despacio?", "pos": "expresión", "exPt": "Desculpe, pode falar mais devagar?", "exEs": "Perdone, ¿puede hablar más despacio?" },
    { "pt": "Como se diz…?", "es": "¿Cómo se dice…?", "pos": "expresión", "exPt": "Como se diz «cuchara» em português?", "exEs": "¿Cómo se dice «cuchara» en portugués?" },
    { "pt": "Que quer dizer…?", "es": "¿Qué quiere decir…?", "pos": "expresión", "exPt": "Que quer dizer «fixe»?", "exEs": "¿Qué quiere decir «fixe»?" },
    { "pt": "Bom fim de semana", "es": "Buen fin de semana", "pos": "expresión", "exPt": "Bom fim de semana! Igualmente.", "exEs": "¡Buen fin de semana! Igualmente." },
    { "pt": "Igualmente", "es": "Igualmente", "pos": "adverbio", "exPt": "— Boas férias! — Igualmente!", "exEs": "— ¡Buenas vacaciones! — ¡Igualmente!" },
    { "pt": "Bom apetite", "es": "Buen provecho / Que aproveche", "pos": "expresión", "exPt": "Bom apetite a todos!", "exEs": "¡Que aproveche a todos!" },
    { "pt": "Cumprimentos", "es": "Saludos, recuerdos", "pos": "sustantivo", "gender": "m", "exPt": "Dá cumprimentos à tua mãe.", "exEs": "Dale recuerdos a tu madre.", "difficulty": 2 },
    { "pt": "um beijinho", "es": "un besito (despedida cariñosa)", "pos": "expresión", "exPt": "Um beijinho e até logo!", "exEs": "¡Un besito y hasta luego!", "register": "informal", "note": "Despedida muy habitual entre familia y amigos, también por mensaje." }
  ]
}
