    { "pt": "julho", "es": "julio", "pos": "sustantivo", "gender": "m", "exPt": "Vamos de férias em julho.", "exEs": "Nos vamos de vacaciones en julio." },
    { "pt": "agosto", "es": "agosto", "pos": "sustantivo", "gender": "m", "exPt": "Em agosto o Algarve está cheio.", "exEs": "En agosto el Algarve está lleno." },
    { "pt": "setembro", "es": "septiembre", "pos": "sustantivo", "gender": "m", "exPt": "As aulas começam em setembro.", "exEs": "Las clases empiezan en septiembre." },
    { "pt": "outubro", "es": "octubre", "pos": "sustantivo", "gender": "m", "exPt": "Em outubro começa a chover.", "exEs": "En octubre empieza a llover." },
    { "pt": "novembro", "es": "noviembre", "pos": "sustantivo", "gender": "m", "exPt": "Em novembro comem-se castanhas.", "exEs": "En noviembre se comen castañas." },
    { "pt": "dezembro", "es": "diciembre", "pos": "sustantivo", "gender": "m", "exPt": "O Natal é em dezembro.", "exEs": "La Navidad es en diciembre." },
    { "pt": "Que dia é hoje?", "es": "¿Qué día es hoy?", "pos": "expresión", "exPt": "— Que dia é hoje? — É dia cinco.", "exEs": "— ¿Qué día es hoy? — Es día cinco." },
    { "pt": "o aniversário", "es": "el cumpleaños", "pos": "sustantivo", "gender": "m", "exPt": "O meu aniversário é a vinte de maio.", "exEs": "Mi cumpleaños es el veinte de mayo.", "note": "Para «cumplir años»: «fazer anos»." },
    { "pt": "o feriado", "es": "el festivo", "pos": "sustantivo", "gender": "m", "exPt": "Segunda-feira é feriado.", "exEs": "El lunes es festivo." },
    { "pt": "as férias", "es": "las vacaciones", "pos": "sustantivo", "gender": "f", "exPt": "Boas férias!", "exEs": "¡Buenas vacaciones!" },
