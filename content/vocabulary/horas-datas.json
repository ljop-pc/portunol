    { "pt": "sábado", "es": "sábado", "pos": "sustantivo", "gender": "m", "exPt": "No sábado vamos à praia.", "exEs": "El sábado vamos a la playa." },
    { "pt": "domingo", "es": "domingo", "pos": "sustantivo", "gender": "m", "exPt": "Ao domingo almoçamos com a família.", "exEs": "Los domingos comemos con la familia." },
    { "pt": "janeiro", "es": "enero", "pos": "sustantivo", "gender": "m", "exPt": "Em janeiro faz muito frio.", "exEs": "En enero hace mucho frío.", "note": "En Portugal los meses se escriben en minúscula." },
    { "pt": "fevereiro", "es": "febrero", "pos": "sustantivo", "gender": "m", "exPt": "O Carnaval é em fevereiro.", "exEs": "El Carnaval es en febrero." },
