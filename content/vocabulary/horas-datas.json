{
  "topic": "horas-datas", "order": 2, "title": "Horas, días y fechas",
  "description": "Decir la hora, los días de la semana, los meses y hablar de cuándo pasa algo.",
  "entries": [
    { "pt": "Que horas são?", "es": "¿Qué hora es?", "pos": "expresión", "exPt": "— Que horas são? — São três e meia.", "exEs": "— ¿Qué hora es? — Son las tres y media.", "note": "En portugués no se pone artículo: «são três», no «são as três»." },
    { "pt": "É uma hora", "es": "Es la una", "pos": "expresión", "exPt": "É uma hora em ponto.", "exEs": "Es la una en punto." },
    { "pt": "São duas horas", "es": "Son las dos", "pos": "expresión", "exPt": "São duas horas, vamos almoçar?", "exEs": "Son las dos, ¿vamos a comer?", "note": "«Hora» es femenino: duas horas (no «dois»)." },
    { "pt": "e um quarto", "es": "y cuarto", "pos": "expresión", "exPt": "São cinco e um quarto.", "exEs": "Son las cinco y cuarto." },
    { "pt": "e meia", "es": "y media", "pos": "expresión", "exPt": "Chego às sete e meia.", "exEs": "Llego a las siete y media." },
    { "pt": "menos um quarto", "es": "menos cuarto", "pos": "expresión", "exPt": "São nove menos um quarto.", "exEs": "Son las nueve menos cuarto.", "note": "También se oye «um quarto para as nove»." },
    { "pt": "em ponto", "es": "en punto", "pos": "expresión", "exPt": "A reunião é às dez em ponto.", "exEs": "La reunión es a las diez en punto." },
    { "pt": "o meio-dia", "es": "el mediodía (12:00)", "pos": "sustantivo", "gender": "m", "exPt": "Almoçamos ao meio-dia.", "exEs": "Comemos a las doce." },
    { "pt": "a meia-noite", "es": "la medianoche (00:00)", "pos": "sustantivo", "gender": "f", "exPt": "Chegámos à meia-noite.", "exEs": "Llegamos a medianoche." },
    { "pt": "da manhã / da tarde / da noite", "es": "de la mañana / tarde / noche", "pos": "expresión", "exPt": "O voo é às três da tarde.", "exEs": "El vuelo es a las tres de la tarde." },
    { "pt": "a hora", "es": "la hora", "pos": "sustantivo", "gender": "f", "exPt": "A que horas abre a farmácia?", "exEs": "¿A qué hora abre la farmacia?", "note": "Se pregunta en plural: «a que horas…?»." },
    { "pt": "o minuto", "es": "el minuto", "pos": "sustantivo", "gender": "m", "exPt": "Espera cinco minutos.", "exEs": "Espera cinco minutos." },
    { "pt": "hoje", "es": "hoy", "pos": "adverbio", "exPt": "Hoje não posso.", "exEs": "Hoy no puedo." },
    { "pt": "amanhã", "es": "mañana", "pos": "adverbio", "exPt": "Até amanhã!", "exEs": "¡Hasta mañana!" },
    { "pt": "ontem", "es": "ayer", "pos": "adverbio", "exPt": "Ontem jantámos fora.", "exEs": "Ayer cenamos fuera." },
    { "pt": "depois de amanhã", "es": "pasado mañana", "pos": "expresión", "exPt": "Voltamos depois de amanhã.", "exEs": "Volvemos pasado mañana." },
    { "pt": "anteontem", "es": "anteayer", "pos": "adverbio", "exPt": "Cheguei anteontem.", "exEs": "Llegué anteayer.", "difficulty": 2 },
