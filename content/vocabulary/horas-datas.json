    { "pt": "o mês", "es": "el mes", "pos": "sustantivo", "gender": "m", "exPt": "No próximo mês vamos a Lisboa.", "exEs": "El mes que viene vamos a Lisboa." },
    { "pt": "o ano", "es": "el año", "pos": "sustantivo", "gender": "m", "exPt": "Bom ano novo!", "exEs": "¡Feliz año nuevo!" },
