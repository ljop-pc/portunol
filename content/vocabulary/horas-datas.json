    { "pt": "abril", "es": "abril", "pos": "sustantivo", "gender": "m", "exPt": "O vinte e cinco de abril é feriado.", "exEs": "El veinticinco de abril es festivo." },
    { "pt": "maio", "es": "mayo", "pos": "sustantivo", "gender": "m", "exPt": "Em maio já está calor.", "exEs": "En mayo ya hace calor." },
