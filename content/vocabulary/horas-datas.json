    { "pt": "terça-feira", "es": "martes", "pos": "sustantivo", "gender": "f", "exPt": "Na terça-feira tenho médico.", "exEs": "El martes tengo médico." },
    { "pt": "quarta-feira", "es": "miércoles", "pos": "sustantivo", "gender": "f", "exPt": "Jogamos futebol à quarta.", "exEs": "Jugamos al fútbol los miércoles." },
    { "pt": "quinta-feira", "es": "jueves", "pos": "sustantivo", "gender": "f", "exPt": "Quinta-feira é feriado.", "exEs": "El jueves es festivo." },
